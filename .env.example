# Supabase 配置（認證用，保留）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# 或使用本地 Supabase
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your-local-anon-key

# VPS Backend API（HTTPS via Let's Encrypt on VPS）
VPS_API_URL=https://api.tellcraft.com
NEXT_PUBLIC_VPS_API_URL=https://api.tellcraft.com
NEXT_PUBLIC_VPS_WS_URL=https://api.tellcraft.com
NEXT_PUBLIC_UPLOAD_BASE_URL=https://api.tellcraft.com/uploads/tellcraft
