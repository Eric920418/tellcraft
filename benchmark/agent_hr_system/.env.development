# Development Environment Variables
# This file is used for local development with docker-compose
# 測試使用 H2，運行使用 MySQL

# ============================================
# 資料庫配置 (MySQL)
# ============================================
DB_ROOT_PASSWORD=rootpassword
DB_NAME=agent_hr
DB_USER=agent_user
DB_PASSWORD=agent_pass
DB_PORT=3306

# ============================================
# 後端配置
# ============================================
BACKEND_PORT=8080
BUILD_TARGET=development
SPRING_PROFILE=dev

# JPA 配置
DDL_AUTO=update
SHOW_SQL=true

# 開發模式下掛載原始碼（hot reload）
# 格式: ./backend/src
BACKEND_SRC_MOUNT=./backend/src

# ============================================
# phpMyAdmin 配置
# ============================================
PHPMYADMIN_PORT=8081

# ============================================
# 前端配置
# ============================================
FRONTEND_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_ENABLE_MOCK=false

# 開發模式下掛載原始碼（hot reload）
# 格式: ./frontend/src 和 ./frontend/public
FRONTEND_SRC_MOUNT=./frontend/src
FRONTEND_PUBLIC_MOUNT=./frontend/public
