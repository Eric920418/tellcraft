# Server
NODE_ENV=production
PORT=3100
SOCKET_VERBOSE_LOG=false

# Database
DATABASE_URL=postgresql://tellcraft_user:YOUR_PASSWORD@localhost:5432/tellcraft

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic (Intent Classification)
ANTHROPIC_API_KEY=sk-ant-xxx

# Supabase Auth (如繼續使用 Supabase Auth)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Vercel (部署)
VERCEL_ACCESS_TOKEN=xxx
VERCEL_TEAM_ID=xxx

# Cloudflare (DNS)
CLOUDFLARE_API_TOKEN=xxx
CLOUDFLARE_ACCOUNT_ID=xxx

# Porkbun (網域購買)
PORKBUN_API_KEY=xxx
PORKBUN_SECRET_KEY=xxx
