{
  "version": "1.0.0",
  "description": "CMS Skeleton — vendored 業務骨架，將 admin auth / CRUD / soft-delete / pagination 等技術約定 lock 進 deterministic 模板，把客製化權力集中到 LLM-fillable slots（plan 75-splendid-token.md Phase 1 起步）",
  "detection": {
    "thresholdScore": 60,
    "rules": {
      "adminLoginFeature": 30,
      "crudPairs": 30,
      "siteSettings": 20,
      "uploadAction": 20
    }
  },
  "modules": {
    "admin_auth": {
      "locked": [
        "bcrypt cost factor (10)",
        "JWT sign algorithm (HS256)",
        "cookie name (userId)",
        "login endpoint (POST /api/admin/login)",
        "logout endpoint (POST /api/admin/logout)"
      ],
      "slots": {
        "canonical_test_username": { "type": "string", "default": "admin", "description": "首頁登入提示顯示的測試帳號" },
        "canonical_test_password": { "type": "string", "default": "admin123", "description": "首頁登入提示顯示的測試密碼" },
        "jwt_expires_in": { "type": "string", "default": "7d" },
        "login_path": { "type": "string", "default": "/admin/login" }
      }
    },
    "soft_delete": {
      "locked": [
        "filter expression (deleted_at IS NULL)",
        "UPDATE deleted_at logic on soft delete"
      ],
      "slots": {
        "enabled_tables": { "type": "string[]", "default": [], "description": "啟用 soft-delete 的表清單（其他自動 hard delete）" },
        "retention_days": { "type": "number|null", "default": null, "description": "soft delete 後多久 hard delete（null = 永不）" }
      }
    },
    "pagination": {
      "locked": [
        "LIMIT/OFFSET 計算邏輯",
        "items/total/page/pageSize/totalPages 回應結構"
      ],
      "slots": {
        "default_page_size": { "type": "number", "default": 50 },
        "max_page_size": { "type": "number", "default": 100 }
      }
    },
    "admin_panel_layout": {
      "locked": [
        "sidebar / topbar / breadcrumb 結構",
        "permission gating (require admin cookie)"
      ],
      "slots": {
        "logo_text": { "type": "string", "default": "" },
        "logo_image_url": { "type": "string|null", "default": null },
        "nav_groups": { "type": "object[]", "default": [] },
        "theme_mode": { "type": "enum", "default": "auto", "options": ["light", "dark", "auto"] }
      }
    }
  },
  "canonical_features": [
    {
      "name": "Admin Login",
      "actionName": "admin_login",
      "path": "/api/admin/login",
      "method": "POST",
      "skeletonModule": "admin_auth"
    },
    {
      "name": "Admin Logout",
      "actionName": "admin_logout",
      "path": "/api/admin/logout",
      "method": "POST",
      "skeletonModule": "admin_auth"
    },
    {
      "name": "List Admins",
      "actionName": "list_admins",
      "path": "/api/admin/admins",
      "method": "GET",
      "skeletonModule": "admin_auth"
    },
    {
      "name": "Update Admin Profile",
      "actionName": "update_admin_profile",
      "path": "/api/admin/profile",
      "method": "PUT",
      "skeletonModule": "admin_auth"
    },
    {
      "name": "Get Site Settings",
      "actionName": "get_site_settings",
      "path": "/api/admin/site-settings",
      "method": "GET",
      "skeletonModule": "site_settings"
    }
  ]
}
