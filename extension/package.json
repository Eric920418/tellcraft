{
  "name": "tellcraft-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome Extension MV3 for Tellcraft inline editor on Vercel preview",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.zip",
    "package": "node package-for-store.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
