# sdd.os ISA Feature File template (SpecFormula standard)
#
# Usage:
# 1. Replace {action_name} with the actual Server Action function name (camelCase)
# 2. Replace {http_method} and {api_path} with the API endpoint
# 3. Replace {summary} with the feature's English verb phrase (matching Feature name)
# 4. Use the VAR system (>/$/<) instead of hardcoded IDs
#
# LANGUAGE POLICY: all code-level content (Feature/Rule/Scenario text, Entity names,
# DataTable values) MUST be in ENGLISH. Only SpecFormula DSL keywords remain in Chinese
# (準備一個/應該存在一個/(STATUS)回應/操作失敗/Rule four-category prefixes).
#
# ============================================================

# Action: {action_name}
# [{http_method}] {api_path}
# Summary: {summary}
Feature: {summary}

  # Background prepares baseline test data. Executed before every Example.
  # Use > to declare a Context Key, < to capture an Execution Key.
  Background:
    Given 準備一個User, with table:
      | >User1.id | email            | name     |
      | <user1Id  | user@example.com | John Doe |
    And 準備一個Product, with table:
      | >Product1.id | name             | price |
      | <product1Id  | Kung Pao Chicken | 120   |

  #------------------------------------------------------------
  # Rule format: {前置|後置}（{sub-category}）- {rule description in English}
  # 前置: precondition (validation before execution; failure → error response)
  # 後置: postcondition (system state change after successful execution)
  #------------------------------------------------------------
  Rule: 後置（狀態）- {rule description in English}
  #------------------------------------------------------------

    # Example name should clearly describe the test scenario (in English)
    Example: Successfully {action_description}
      # When step: call the Server Action (MUST have Actor prefix)
      # Format: (No Actor|UID="$var") {summary}, call table:
      When (UID="${Entity1}.id") {summary}, call table:
        | {input_field1}  | {input_field2} |
        | ${Entity2}.id   | value2         |

      # Then step (success): verify response (include HTTP status code)
      # Format: {summary}(STATUS)回應, with table:
      Then {summary}(201)回應, with table:
        | >{result}.{field1} | {output_field2} |
        | <resultField1      | expected2       |

      # Optional: verify DB state
      # Format: 應該存在一個{Entity}, with table:
      And 應該存在一個{Entity}, with table:
        | entityId      | {field1}  | {field2}  |
        | ${Entity1}.id | expected1 | expected2 |

  #------------------------------------------------------------
  Rule: 前置（狀態）- {validation condition description in English}
  #------------------------------------------------------------

    # Failure scenario example
    Example: Reject the operation when {validation_description}
      # Given can override data set up in Background
      Given 準備一個{Entity}, with table:
        | >{Entity3}.id | {field1}       | {field2} |
        | <entity3Id    | invalid_value  | value    |

      When (UID="${Entity1}.id") {summary}, call table:
        | {input_field1}  | {input_field2} |
        | ${Entity3}.id   | value          |

      # Then step (failure): assert operation failure
      Then 操作失敗

# ============================================================
# Checklist (delete this section when done)
# ============================================================
# [ ] Action name is camelCase (e.g. createOrder)
# [ ] Has [METHOD] /path HTTP endpoint comment
# [ ] Summary matches the Feature name exactly (both English verb phrase)
# [ ] Every Rule has one of the four category prefixes (前置（狀態）/ 前置（參數）/ 後置（回應）/ 後置（狀態）)
# [ ] When steps have an Actor prefix (No Actor|UID="$var")
# [ ] Success Then uses "{summary}(STATUS)回應, with table:" format
# [ ] Failure Then uses "操作失敗"
# [ ] Entity validation uses "應該存在一個{EntityName}, with table:"
# [ ] DataTable uses the VAR system (>/$/<) instead of hardcoded UUIDs
# [ ] DataTable columns match schema.sql
# [ ] Entity names match the Entity Mapping (PascalCase English)
