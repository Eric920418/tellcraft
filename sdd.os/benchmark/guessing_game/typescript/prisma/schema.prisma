generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Game entity - represents a 1A2B game instance
model Game {
  id        String   @id
  status    String
  winnerId  String?
  round     Int      @default(1)
  createdAt DateTime @default(now())
  players   Player[]
  guesses   Guess[]
}

// Player entity - represents a player in a game
model Player {
  id      Int      @id @default(autoincrement())
  gameId  String
  role    String
  name    String
  secret  String?
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  guesses Guess[]

  @@index([gameId])
}

// Guess entity - represents a guess made by a player
model Guess {
  id         Int      @id @default(autoincrement())
  gameId     String
  playerId   Int
  round      Int
  guess      String
  resultA    Int
  resultB    Int
  createdAt  DateTime @default(now())
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([playerId])
}
