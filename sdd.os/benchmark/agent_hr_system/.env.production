# Production Environment Variables
# This file is used for production deployment with docker-compose
# 測試使用 H2，運行使用 MySQL
# IMPORTANT: Change all passwords before deploying to production!

# ============================================
# 資料庫配置 (MySQL)
# ============================================
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
DB_NAME=agent_hr
DB_USER=agent_user
DB_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD
DB_PORT=3306

# ============================================
# 後端配置
# ============================================
BACKEND_PORT=8080
BUILD_TARGET=production
SPRING_PROFILE=prod

# JPA 配置（生產環境不要使用 update，應該用 validate）
DDL_AUTO=validate
SHOW_SQL=false

# 生產環境不掛載原始碼
BACKEND_SRC_MOUNT=/dev/null

# ============================================
# 前端配置
# ============================================
FRONTEND_PORT=3000
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_ENABLE_MOCK=false

# 生產環境不掛載原始碼
FRONTEND_SRC_MOUNT=/dev/null
FRONTEND_PUBLIC_MOUNT=/dev/null
